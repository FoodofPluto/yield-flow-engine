log_format furuflow '$remote_addr - $request_method $uri $status $body_bytes_sent';

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

map $http_x_forwarded_proto $furuflow_forwarded_proto {
    default $http_x_forwarded_proto;
    '' $scheme;
}

server {
    listen ${PORT};
    server_name _;

    access_log /dev/stdout furuflow;
    error_log /dev/stderr warn;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # The broker's authenticated internal API is deliberately never public.
    location = /v1/session {
        return 404;
    }

    location ^~ /v1/session/ {
        return 404;
    }

    # Never write the single-use activation ticket query to the access log.
    location = /auth/session/activate {
        access_log off;
        proxy_pass http://127.0.0.1:8510;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $furuflow_forwarded_proto;
        proxy_set_header X-FuruFlow-Bridge-Key "";
    }

    location / {
        proxy_pass http://127.0.0.1:8501;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $furuflow_forwarded_proto;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }
}
