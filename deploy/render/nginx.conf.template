log_format furuflow '$remote_addr - $request_method $uri $status $body_bytes_sent';

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

map $http_x_forwarded_proto $furuflow_forwarded_proto {
    default $http_x_forwarded_proto;
    '' $scheme;
}

server {
    listen ${PORT};
    server_name _;

    access_log /dev/stdout furuflow;
    error_log /dev/stderr warn;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # The broker's authenticated internal API is deliberately never public.
    location = /v1/session {
        return 404;
    }

    location ^~ /v1/session/ {
        return 404;
    }

    # Public billing actions authenticate with the existing opaque HttpOnly
    # session cookie. They accept no browser-supplied account/customer IDs.
    location = /billing/checkout {
        limit_except POST { deny all; }
        proxy_pass http://127.0.0.1:8510;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $furuflow_forwarded_proto;
    }

    location = /billing/portal {
        limit_except POST { deny all; }
        proxy_pass http://127.0.0.1:8510;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $furuflow_forwarded_proto;
    }

    # Stripe is the only intended unauthenticated caller. The sidecar verifies
    # the signature before recording or applying an event.
    location = /stripe/webhook {
        limit_except POST { deny all; }
        proxy_pass http://127.0.0.1:8510;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $furuflow_forwarded_proto;
    }

    # Never write the single-use activation ticket query to the access log.
    location = /auth/session/activate {
        access_log off;
        error_log /dev/null crit;
        proxy_pass http://127.0.0.1:8510;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $furuflow_forwarded_proto;
        proxy_set_header X-FuruFlow-Bridge-Key "";
    }

    # Fail closed for every unsupported session-auth route instead of allowing
    # ticket-bearing malformed paths to reach the Streamlit catch-all.
    location = /auth/session {
        access_log off;
        add_header Cache-Control "no-store" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header X-Content-Type-Options "nosniff" always;
        default_type text/plain;
        return 404 "Session activation unavailable.\n";
    }

    location ^~ /auth/session/ {
        access_log off;
        add_header Cache-Control "no-store" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header X-Content-Type-Options "nosniff" always;
        default_type text/plain;
        return 404 "Session activation unavailable.\n";
    }

    location / {
        proxy_pass http://127.0.0.1:8501;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $furuflow_forwarded_proto;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }
}
