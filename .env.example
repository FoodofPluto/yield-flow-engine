# Development flag does not grant Pro or admin access.
DEV_MODE=false

# Supabase auth. ENVIRONMENT: development, preview/staging, production, or test.
ENVIRONMENT=development
# Must be the project root. Never append /rest/v1, /auth/v1, or another API path.
SUPABASE_URL=https://PROJECT_REFERENCE.supabase.co
SUPABASE_ANON_KEY=REPLACE_WITH_PUBLISHABLE_OR_ANON_KEY
# Configure the callback base for every deployment class used. The active
# variable is selected from ENVIRONMENT; values must not include query/fragment.
SUPABASE_REDIRECT_URL_DEVELOPMENT=http://localhost:8501
SUPABASE_REDIRECT_URL_PREVIEW=https://PREVIEW_HOST/auth/callback
SUPABASE_REDIRECT_URL_PRODUCTION=https://PRODUCTION_HOST/auth/callback
# Optional exact override. Defaults to the validated project root plus the path below.
SUPABASE_JWKS_URL=

# Trusted backend/CLI only. Never provide these to the Streamlit process except
# FURUFLOW_SESSION_BRIDGE_KEY, which authenticates Streamlit to the sidecar.
SUPABASE_SERVICE_ROLE_KEY=
FURUFLOW_SESSION_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY_IN_SESSION_BROKER_ONLY
FURUFLOW_SESSION_BRIDGE_KEY=REPLACE_WITH_RANDOM_INTERNAL_SHARED_SECRET
FURUFLOW_SESSION_BROKER_INTERNAL_URL=http://127.0.0.1:8510
FURUFLOW_SESSION_BROKER_PUBLIC_ORIGIN=https://APP_HOST

# Stripe settings for production webhook/backend
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Telegram auto-posting
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=-1001234567890
FURUFLOW_SIGNAL_SOURCE=defillama
FURUFLOW_SIGNAL_MIN_TVL=1000000
FURUFLOW_SIGNAL_MIN_APY=8
FURUFLOW_SIGNAL_MAX_APY=200
FURUFLOW_SIGNAL_MIN_RISK=0
FURUFLOW_SIGNAL_MAX_RISK=100
FURUFLOW_SIGNAL_MIN_STRENGTH=0
FURUFLOW_SIGNAL_MAX_STRENGTH=100
FURUFLOW_SIGNAL_TOP_N=5
FURUFLOW_SIGNAL_SCAN_DEPTH=250
FURUFLOW_SIGNAL_DEBUG=false
FURUFLOW_SIGNAL_MAX_POSTS=3
FURUFLOW_SIGNAL_CHAINS=base,arbitrum,optimism,polygon,ethereum
FURUFLOW_SIGNAL_STABLECOIN_ONLY=false
FURUFLOW_SIGNAL_ALLOW_REPOSTS=false
FURUFLOW_SIGNAL_DEDUPE_HOURS=24
FURUFLOW_SIGNAL_DRY_RUN=false
FURUFLOW_POSTED_SIGNALS_FILE=posted_signals.json

# Telegram transport tuning
TELEGRAM_CONNECT_TIMEOUT=10
TELEGRAM_READ_TIMEOUT=45
TELEGRAM_RETRY_COUNT=3
TELEGRAM_RETRY_SLEEP_SECONDS=5
TELEGRAM_DISABLE_SSL_VERIFY=false
TELEGRAM_ENABLE_POWERSHELL_FALLBACK=true


# Signal alerts
FURUFLOW_ENABLE_ALERTS=true
FURUFLOW_ALERT_MIN_SCORE=70
FURUFLOW_ALERT_MIN_APY=25
FURUFLOW_ALERT_MIN_TVL=1000000
FURUFLOW_ALERT_MIN_TREND=20

# X posting (set live=false first and review x_post_outbox.txt)
FURUFLOW_X_MODE=signals
FURUFLOW_X_MAX_POSTS=2
FURUFLOW_X_POST_LIVE=false
X_API_KEY=your_x_api_key
X_API_SECRET=your_x_api_secret
X_ACCESS_TOKEN=your_x_access_token
X_ACCESS_TOKEN_SECRET=your_x_access_token_secret
